# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env is git-ignored. Never commit a real key value.
# `uv run msai-demo doctor` reports credential readiness and never prints a
# value. Blank and obvious placeholder values are reported as missing.
#
# Real shell variables always win over this file, so you can override any
# single value for one run without editing anything.
# ---------------------------------------------------------------------------

# --- Provider selection ----------------------------------------------------
# Default chat provider for every command when --provider is not passed.
# Accepted values: openai | anthropic | claude | foundry | azure | local |
#                  foundry-local | offline
# `offline` is a real, deterministic code path, not a stub: it runs the same
# orchestration with a scripted model so the demo works with no credentials.
MSAI_PROVIDER=openai

# --- OpenAI (default path) -------------------------------------------------
# Required for --provider openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Read by agent-framework-openai. OPENAI_CHAT_MODEL drives the Responses
# client (OpenAIChatClient); the other drives Chat Completions.
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_COMPLETION_MODEL=gpt-5.4-mini

# --- Anthropic (second vendor in the cross-vendor group chat) --------------
# Required for --provider anthropic and for `group-chat --cross-vendor`.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Read by agent-framework-anthropic.
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Microsoft Foundry (cloud) ---------------------------------------------
# Project endpoint from the Microsoft Foundry portal. Leave blank and every
# Foundry demo reports mode "no_endpoint" instead of pretending.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4o-mini
# Only needed if you connect a Prompt Agent or Hosted Agent by name.
FOUNDRY_AGENT_NAME=

# --- Azure OpenAI (a standalone resource, not a Foundry project) -----------
# agent-framework-openai talks to Azure OpenAI through the same clients.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=

# --- Microsoft Entra (workload identity for every Azure AI data plane) -----
# A service principal. azure-identity's EnvironmentCredential reads these
# three names exactly. `msai-demo entra` proves the token chain works and
# never prints a token.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure AI Search (retrieval / Foundry IQ grounding) --------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=msai-workshop
# Optional. Prefer Entra (leave blank) over a key.
AZURE_SEARCH_API_KEY=

# --- Foundry guardrails and content safety ---------------------------------
# An Azure AI services / Content Safety endpoint.
AZURE_CONTENT_SAFETY_ENDPOINT=

# --- Foundry Local (on-device inference) -----------------------------------
# Model alias resolved by the Foundry Local service. `msai-demo foundry-local`
# reports mode "service_unavailable" when the service is not running.
FOUNDRY_LOCAL_MODEL=phi-4-mini

# --- Observability ---------------------------------------------------------
# Agent Framework instruments by default. Ordinary commands in this repo turn
# it OFF before any client is constructed; `--otel` opts back in.
ENABLE_INSTRUMENTATION=false
# Never enable sensitive data outside development: it records prompts,
# responses, tool arguments and tool results.
ENABLE_SENSITIVE_DATA=false
ENABLE_CONSOLE_EXPORTERS=false
# Point at an OTLP collector, for example the Aspire dashboard on 4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=microsoft-ai-stack-workshop
# Application Insights, if you would rather send traces to Azure Monitor.
APPLICATIONINSIGHTS_CONNECTION_STRING=
